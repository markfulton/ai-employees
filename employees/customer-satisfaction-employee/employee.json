{
  "schema": "ai-employee/1",
  "slug": "customer-satisfaction-employee",
  "name": "Customer Satisfaction Employee",
  "role": "Support and retention",
  "version": "1.7.0",
  "standard": "1.3",
  "repository": "https://github.com/markfulton/ai-employees",
  "license": "MIT",
  "requires": {
    "node": ">=18",
    "harness": [
      "claude-code",
      "openclaw",
      "hermes",
      "opencode",
      "grok-bot",
      "codex",
      "antigravity"
    ]
  },
  "connections": [
    {
      "capability": "helpdesk.read",
      "providers": [
        "intercom",
        "help-scout",
        "front",
        "zoho-desk"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "helpdesk.note",
      "providers": [
        "front",
        "intercom",
        "gmail"
      ],
      "required": false,
      "readonly": false
    },
    {
      "capability": "mail.read",
      "providers": [
        "gmail",
        "microsoft-365"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "community.read",
      "providers": [
        "slack",
        "discord-api"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "billing.read",
      "providers": [
        "stripe-restricted-key",
        "paddle",
        "chargebee"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "usage.read",
      "providers": [
        "posthog",
        "supabase-readonly"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "reviews.read",
      "providers": [
        "trustpilot-api",
        "expo"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "helpcentre.read",
      "providers": [
        "intercom",
        "notion"
      ],
      "required": false,
      "readonly": true
    }
  ],
  "routines": [
    {
      "id": "csat-churn-watch",
      "days": "mon-fri",
      "fire": "09:20",
      "window_start": "09:05",
      "window_end": "13:00",
      "period_key": "YYYY-MM-DD",
      "budget": "25 min",
      "browser": "conditional"
    },
    {
      "id": "csat-deflection-desk",
      "days": "wed",
      "fire": "11:00",
      "window_start": "10:45",
      "window_end": "15:00",
      "period_key": "YYYY-Www",
      "budget": "25 min",
      "browser": "light"
    },
    {
      "id": "csat-desk-intake",
      "days": "first-weekday",
      "fire": "13:00",
      "window_start": "12:45",
      "window_end": "17:00",
      "period_key": "YYYY-MM",
      "budget": "45 min",
      "browser": "light"
    },
    {
      "id": "csat-desk-standup",
      "days": "mon-fri",
      "fire": "07:30",
      "window_start": "07:15",
      "window_end": "11:30",
      "period_key": "YYYY-MM-DD",
      "budget": "15 min",
      "browser": "never"
    },
    {
      "id": "csat-inbox-sweep",
      "days": "mon-fri",
      "fire": "06:45",
      "window_start": "06:30",
      "window_end": "09:45",
      "period_key": "YYYY-MM-DD",
      "budget": "25 min",
      "browser": "heavy"
    },
    {
      "id": "csat-reply-desk",
      "days": "mon-fri",
      "fire": "08:15",
      "window_start": "08:00",
      "window_end": "12:00",
      "period_key": "YYYY-MM-DD",
      "budget": "30 min",
      "browser": "conditional"
    },
    {
      "id": "csat-satisfaction-report",
      "days": "fri",
      "fire": "16:00",
      "window_start": "15:45",
      "window_end": "19:00",
      "period_key": "YYYY-Www",
      "budget": "35 min",
      "browser": "conditional"
    },
    {
      "id": "csat-taxonomy-refresh",
      "days": "last-weekday",
      "fire": "14:00",
      "window_start": "13:45",
      "window_end": "17:30",
      "period_key": "YYYY-MM",
      "budget": "35 min",
      "browser": "light"
    }
  ],
  "files": {
    "kit": [
      "AGENTS.md",
      "CAPABILITIES.md",
      "CHANGELOG.md",
      "CONTRACT.md",
      "INSTALL-PROMPT.md",
      "README.md",
      "ROLE.md",
      "VERSION",
      ".gitignore",
      "employee.json",
      "recipes/BROWSER-RECIPES.md",
      "routines/**",
      "run/**",
      "scripts/**",
      "examples/**"
    ],
    "merge": [
      "SCHEDULE.md"
    ],
    "member": [
      "RELEASES.md",
      "state/**",
      "board/**",
      "crm/**",
      "queue/**",
      "strategy/**",
      "briefs/**",
      "scoreboard/**",
      "dashboard/**",
      "improvements/**",
      "archive/**",
      "paid/**",
      "fleet/**",
      "drafts/**",
      "calendar/**",
      "run/*.log",
      "recipes/*.json",
      "runlog.jsonl",
      "*-latest.md",
      ".installed.json",
      "desk/**",
      "tickets/**",
      "risk/**",
      "macros/**",
      "help/**",
      "report/**",
      "PAUSED",
      "schedule-commands.txt"
    ]
  },
  "notes": {
    "merge": "SCHEDULE.md carries the shape the kit ships and the days, windows and budgets the member owns. An upgrade reports a changed shape and never rewrites the row values.",
    "member": "Everything under member is the business the employee has been running: its evidence, its ledgers, its learned browser flows and its own field repairs. An upgrade that overwrites any of it has destroyed work that exists nowhere else.",
    "recipes": "recipes/BROWSER-RECIPES.md ships with the kit. Every recipes/*.json is learned on the member's own screens by the routine that owns it, so it is member data."
  }
}
