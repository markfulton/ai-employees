{
  "schema": "ai-employee/1",
  "slug": "gtm-engineer",
  "name": "GTM Engineer",
  "role": "Go to market and launch",
  "version": "1.4.0",
  "standard": "1.2",
  "repository": "https://github.com/markfulton/ai-employees",
  "license": "MIT",
  "requires": {
    "node": ">=18",
    "harness": [
      "claude-code",
      "openclaw",
      "hermes",
      "opencode",
      "grok-bot",
      "codex",
      "antigravity"
    ]
  },
  "routines": [
    {
      "id": "gtm-board-standup",
      "days": "mon-fri",
      "fire": "07:30",
      "window_start": "07:15",
      "window_end": "11:30",
      "period_key": "YYYY-MM-DD",
      "budget": "12 min",
      "browser": "never"
    },
    {
      "id": "gtm-icp-refresh",
      "days": "last-weekday",
      "fire": "14:00",
      "window_start": "13:45",
      "window_end": "17:30",
      "period_key": "YYYY-MM",
      "budget": "35 min",
      "browser": "light"
    },
    {
      "id": "gtm-intake-and-dashboard",
      "days": "first-weekday",
      "fire": "13:00",
      "window_start": "12:45",
      "window_end": "17:00",
      "period_key": "YYYY-MM",
      "budget": "45 min",
      "browser": "light"
    },
    {
      "id": "gtm-launch-step-runner",
      "days": "mon-fri",
      "fire": "09:15",
      "window_start": "09:00",
      "window_end": "13:00",
      "period_key": "YYYY-MM-DD",
      "budget": "35 min",
      "browser": "conditional"
    },
    {
      "id": "gtm-outreach-queue",
      "days": "mon-fri",
      "fire": "08:15",
      "window_start": "08:00",
      "window_end": "12:00",
      "period_key": "YYYY-MM-DD",
      "budget": "30 min",
      "browser": "conditional"
    },
    {
      "id": "gtm-paid-and-tracking-guard",
      "days": "mon",
      "fire": "11:00",
      "window_start": "10:45",
      "window_end": "15:00",
      "period_key": "YYYY-Www",
      "budget": "20 min",
      "browser": "read only"
    },
    {
      "id": "gtm-scoreboard",
      "days": "fri",
      "fire": "16:00",
      "window_start": "15:45",
      "window_end": "19:00",
      "period_key": "YYYY-Www",
      "budget": "35 min",
      "browser": "read only"
    },
    {
      "id": "gtm-signal-sweep",
      "days": "mon-fri",
      "fire": "06:45",
      "window_start": "06:30",
      "window_end": "09:45",
      "period_key": "YYYY-MM-DD",
      "budget": "25 min",
      "browser": "heavy"
    }
  ],
  "files": {
    "kit": [
      "AGENTS.md",
      "CAPABILITIES.md",
      "CHANGELOG.md",
      "CONTRACT.md",
      "INSTALL-PROMPT.md",
      "README.md",
      "ROLE.md",
      "VERSION",
      ".gitignore",
      "employee.json",
      "recipes/BROWSER-RECIPES.md",
      "routines/**",
      "run/**",
      "scripts/**",
      "examples/**"
    ],
    "merge": [
      "SCHEDULE.md"
    ],
    "member": [
      "RELEASES.md",
      "state/**",
      "board/**",
      "crm/**",
      "queue/**",
      "strategy/**",
      "briefs/**",
      "scoreboard/**",
      "dashboard/**",
      "improvements/**",
      "archive/**",
      "paid/**",
      "fleet/**",
      "drafts/**",
      "calendar/**",
      "run/*.log",
      "recipes/*.json",
      "runlog.jsonl",
      "*-latest.md",
      ".installed.json"
    ]
  },
  "notes": {
    "merge": "SCHEDULE.md carries the shape the kit ships and the days, windows and budgets the member owns. An upgrade reports a changed shape and never rewrites the row values.",
    "member": "Everything under member is the business the employee has been running: its evidence, its ledgers, its learned browser flows and its own field repairs. An upgrade that overwrites any of it has destroyed work that exists nowhere else.",
    "recipes": "recipes/BROWSER-RECIPES.md ships with the kit. Every recipes/*.json is learned on the member's own screens by the routine that owns it, so it is member data."
  }
}
