{
  "schema": "ai-employee/1",
  "slug": "sales-employee",
  "name": "Sales Employee",
  "role": "Pipeline and outreach",
  "version": "1.7.0",
  "standard": "1.3",
  "repository": "https://github.com/markfulton/ai-employees",
  "license": "MIT",
  "requires": {
    "node": ">=18",
    "harness": [
      "claude-code",
      "openclaw",
      "hermes",
      "opencode",
      "grok-bot",
      "codex",
      "antigravity"
    ]
  },
  "connections": [
    {
      "capability": "mail.read",
      "providers": [
        "gmail",
        "microsoft-365"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "mail.draft",
      "providers": [
        "gmail"
      ],
      "required": false,
      "readonly": false
    },
    {
      "capability": "calendar.read",
      "providers": [
        "google-calendar",
        "microsoft-365"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "crm.read",
      "providers": [
        "hubspot",
        "attio",
        "close",
        "zoho-crm",
        "salesflare",
        "salesforce"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "people.search",
      "providers": [
        "apollo",
        "clay",
        "zoominfo"
      ],
      "required": false,
      "readonly": true
    },
    {
      "capability": "billing.read",
      "providers": [
        "stripe-restricted-key"
      ],
      "required": false,
      "readonly": true
    }
  ],
  "routines": [
    {
      "id": "sales-desk-setup",
      "days": "first-weekday",
      "fire": "11:00",
      "window_start": "10:45",
      "window_end": "15:00",
      "period_key": "YYYY-MM",
      "budget": "45 min",
      "browser": "light"
    },
    {
      "id": "sales-desk-standup",
      "days": "mon-fri",
      "fire": "07:30",
      "window_start": "07:15",
      "window_end": "11:30",
      "period_key": "YYYY-MM-DD",
      "budget": "12 min",
      "browser": "never"
    },
    {
      "id": "sales-first-touch-drafts",
      "days": "mon-fri",
      "fire": "08:15",
      "window_start": "08:00",
      "window_end": "12:00",
      "period_key": "YYYY-MM-DD",
      "budget": "30 min",
      "browser": "heavy"
    },
    {
      "id": "sales-followup-sweep",
      "days": "mon-fri",
      "fire": "13:30",
      "window_start": "13:15",
      "window_end": "17:00",
      "period_key": "YYYY-MM-DD",
      "budget": "35 min",
      "browser": "heavy"
    },
    {
      "id": "sales-pipeline-review",
      "days": "fri",
      "fire": "16:00",
      "window_start": "15:45",
      "window_end": "19:00",
      "period_key": "YYYY-Www",
      "budget": "35 min",
      "browser": "conditional"
    },
    {
      "id": "sales-prospect-sweep",
      "days": "mon-fri",
      "fire": "06:45",
      "window_start": "06:30",
      "window_end": "09:45",
      "period_key": "YYYY-MM-DD",
      "budget": "25 min",
      "browser": "heavy"
    },
    {
      "id": "sales-qualification-refresh",
      "days": "last-weekday",
      "fire": "11:30",
      "window_start": "11:15",
      "window_end": "15:30",
      "period_key": "YYYY-MM",
      "budget": "30 min",
      "browser": "light"
    }
  ],
  "files": {
    "kit": [
      "AGENTS.md",
      "CAPABILITIES.md",
      "CHANGELOG.md",
      "CONTRACT.md",
      "INSTALL-PROMPT.md",
      "README.md",
      "ROLE.md",
      "VERSION",
      ".gitignore",
      "employee.json",
      "recipes/BROWSER-RECIPES.md",
      "routines/**",
      "run/**",
      "scripts/**",
      "examples/**"
    ],
    "merge": [
      "SCHEDULE.md"
    ],
    "member": [
      "RELEASES.md",
      "state/**",
      "board/**",
      "crm/**",
      "queue/**",
      "strategy/**",
      "briefs/**",
      "scoreboard/**",
      "dashboard/**",
      "improvements/**",
      "archive/**",
      "paid/**",
      "fleet/**",
      "drafts/**",
      "calendar/**",
      "run/*.log",
      "recipes/*.json",
      "runlog.jsonl",
      "*-latest.md",
      ".installed.json"
    ]
  },
  "notes": {
    "merge": "SCHEDULE.md carries the shape the kit ships and the days, windows and budgets the member owns. An upgrade reports a changed shape and never rewrites the row values.",
    "member": "Everything under member is the business the employee has been running: its evidence, its ledgers, its learned browser flows and its own field repairs. An upgrade that overwrites any of it has destroyed work that exists nowhere else.",
    "recipes": "recipes/BROWSER-RECIPES.md ships with the kit. Every recipes/*.json is learned on the member's own screens by the routine that owns it, so it is member data."
  }
}
